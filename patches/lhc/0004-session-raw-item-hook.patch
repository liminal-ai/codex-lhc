+    assert_eq!(
+        closed.started_at.as_deref(),
+        Some("2024-07-03T09:46:40.000Z")
+    );
+    assert_eq!(closed.ended_at.as_deref(), Some("2024-07-03T09:47:22.000Z"));
+
+    handle.shutdown().await;
