+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner) = None;
+        *MIDTURN_WORKER_STALL_OVERRIDE
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner) = None;
+    }
+}
