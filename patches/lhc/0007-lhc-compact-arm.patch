+async fn run_arm_deterministic(
+    sess: &Arc<Session>,
+    tc: &crate::session::turn_context::TurnContext,
+    manual: bool,
+) -> LhcCompactAttempt {
+    try_run_lhc_compact_arm_with_callbacks(
+        sess,
+        tc,
+        InitialContextInjection::DoNotInject,
+        manual,
+        deterministic_callbacks(),
+    )
