+            | LhcCompactAttempt::MidTurnBlocked { reason, .. }
+            | LhcCompactAttempt::ContinuedWithoutCompact { reason } => {
+                assert!(!reason.is_empty(), "degradation residual must be truthful");
+            }
+            LhcCompactAttempt::Unavailable { reason }
