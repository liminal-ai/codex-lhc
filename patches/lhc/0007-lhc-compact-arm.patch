+            &tc,
+            InitialContextInjection::DoNotInject,
+            /*manual*/ false,
+            CompactionPhase::MidTurn,
+            Some(mid_facts(
+                "invalid-install-1",
+                true,
+                decision_epoch(&sess),
+                Vec::new(),
+                Some(sample_usage(5_000)),
