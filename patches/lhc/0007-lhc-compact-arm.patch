+/// I2: install then drop process slot (crash before archive note) — durable
+/// CompactedItem record reseeds and blocks re-ingest.
+#[tokio::test]
+async fn crash_between_install_and_marker_no_reingest() {
+    let dir = tempdir().unwrap();
