+/// True when `slug` is a gpt-5.6 family model (sol/terra/luna and suffixes).
+pub fn is_gpt_5_6_family(slug: &str) -> bool {
+    let base = slug.rsplit('/').next().unwrap_or(slug);
+    base == "gpt-5.6" || base.starts_with("gpt-5.6-")
