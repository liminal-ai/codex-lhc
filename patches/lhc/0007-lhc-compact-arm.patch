+/// Law 2: replace_compacted_history clears prefill.
+#[tokio::test]
+async fn replace_compacted_history_clears_prefill_for_threshold_untrip() {
+    let dir = tempdir().expect("tempdir");
+    let _ = dir;
+    let (session, _tc) = make_session_and_context().await;
