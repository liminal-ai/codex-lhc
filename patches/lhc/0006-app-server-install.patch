+    let before = capture_history_snapshot(&mut mcp, &thread.id, lhc_root.path()).await?;
+    refuse_revert_and_assert_unchanged(
+        &mut mcp,
+        &thread.id,
+        &second.turn.id,
+        lhc_root.path(),
+        &before,
+    )
+    .await?;
+    Ok(())
+}
