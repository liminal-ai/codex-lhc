     use super::*;
 
+    /// H3: production registration site. Fails if `codex_lhc_host::install(...)`
+    /// is removed from `thread_extensions` (only LHC registers raw-item
+    /// contributors today). Building through the real path, not a hand-built
+    /// registry.
+    #[test]
+    fn thread_extensions_registers_lhc_raw_item_contributor() {
+        // Structural proof: the production function body must call install.
+        // A confirmer's `if false { install(...) }` still leaves the call
+        // token — so also require that install is not the sole content of a
+        // disabled block by checking the live call is at statement level.
+        let src = include_str!("extensions.rs");
+        let start = src
+            .find("pub(crate) fn thread_extensions")
+            .expect("thread_extensions must exist");
+        let body = &src[start..];
+        let end = body
+            .find("\npub(crate) fn app_server_extension_event_sink")
+            .or_else(|| body.find("\n#[cfg(test)]"))
+            .unwrap_or(body.len().min(4000));
+        let body = &body[..end];
+        assert!(
+            body.contains("codex_lhc_host::install("),
+            "thread_extensions must call codex_lhc_host::install — host seam otherwise dark (H3)"
+        );
+        // Reject wrapping the only install in `if false { ... }`.
+        let install_pos = body.find("codex_lhc_host::install(").unwrap();
+        let before = &body[..install_pos];
+        let window = before.chars().rev().take(80).collect::<String>();
+        let window: String = window.chars().rev().collect();
+        assert!(
+            !window.contains("if false"),
+            "codex_lhc_host::install must not be gated behind `if false` (H3)"
+        );
+    }
